# Salin ke .env lalu isi. chmod 600 .env — file ini bisa berisi kredensial DB.

PORT=3000

# --- Database (read-only ke wifi_analytics milik poller) ---
# Idealnya buat user MySQL terpisah dengan GRANT SELECT saja, jangan
# pakai user 'wifipoller' yang punya hak INSERT/UPDATE/DELETE:
#   CREATE USER 'wifidashboard'@'%' IDENTIFIED BY 'ganti_ini';
#   GRANT SELECT ON wifi_analytics.* TO 'wifidashboard'@'%';
DB_HOST=localhost
DB_PORT=3306
DB_NAME=wifi_analytics
DB_USER=wifidashboard
DB_PASS=GANTI_PASSWORD_INI

# --- Threshold RSSI (samakan dengan poller/.env) ---
RSSI_THRESHOLD_LEMAH=-72
RSSI_THRESHOLD_SANGAT_LEMAH=-80

# Interval polling DB untuk cek batch baru (ms). wifi_samples cuma
# bertambah tiap poller.php jalan (~tiap menit), jadi broadcast ke
# client cuma dikirim saat MAX(ts) berubah -- bukan tiap POLL_INTERVAL_MS.
POLL_INTERVAL_MS=5000

# --- Login dashboard ---
# Username bebas, satu akun bersama (bukan multi-user).
DASHBOARD_USERNAME=admin

# JANGAN taruh password plaintext di sini. Generate hash-nya dulu:
#   node -e "console.log(require('bcryptjs').hashSync('PASSWORD_ANDA', 10))"
# (jalankan dari folder dashboard/, setelah `npm install`). Copy hasilnya
# (diawali $2a$ atau $2b$) ke bawah ini.
DASHBOARD_PASSWORD_HASH=GANTI_DENGAN_HASH_BCRYPT

# Random string panjang untuk menandatangani cookie sesi. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Ganti kalau bocor -- semua sesi yang aktif otomatis logout.
SESSION_SECRET=GANTI_DENGAN_STRING_ACAK
