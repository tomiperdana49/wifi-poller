# Salin ke .env lalu isi kredensial. chmod 600 .env — file ini berisi rahasia.

# WAJIB cocok dengan timezone server MySQL Anda (cek: SELECT @@system_time_zone).
# Kalau php.ini server default beda dari timezone MySQL, resolusi username
# gagal diam-diam tanpa error. Jangan andalkan default php.ini server.
TIMEZONE=Asia/Jakarta

# --- Database ---
# Kalau wifi_analytics dan radiusdb ada di server MySQL YANG SAMA, cukup
# isi DB_USER/DB_PASS saja (dipakai sebagai fallback untuk keduanya).
# Kalau BEDA server (mis. wifi_analytics di server sendiri, radiusdb di
# server produksi FreeRADIUS), isi DB_ANALYTICS_USER/PASS dan
# DB_RADIUS_USER/PASS secara terpisah -- itu akan menimpa fallback.
DB_ANALYTICS_DSN=mysql:host=localhost;dbname=wifi_analytics;charset=utf8mb4
DB_RADIUS_DSN=mysql:host=localhost;dbname=radiusdb;charset=utf8mb4
DB_USER=wifipoller
DB_PASS=GANTI_PASSWORD_INI
# DB_ANALYTICS_USER=
# DB_ANALYTICS_PASS=
# DB_RADIUS_USER=
# DB_RADIUS_PASS=

# --- Threshold & retensi ---
RSSI_THRESHOLD_LEMAH=-72
RSSI_THRESHOLD_SANGAT_LEMAH=-80
RETENSI_RAW_HARI=14
RETENSI_HOURLY_HARI=730

# --- Runtime (lock file + cache token) ---
LOCK_FILE=/var/lib/wifi-poller/poller.lock
TOKEN_DIR=/var/lib/wifi-poller

# --- Omada ---
# Settings > Platform Integration > Open API. Omada Cloud Essentials
# (tier gratis) TIDAK mendukung Open API — lihat Bagian 1.1 tutorial.
OMADA_ENABLED=false
OMADA_LABEL=omada-kantor-pusat
OMADA_BASE_URL=https://10.10.15.10:8043
OMADA_OMADAC_ID=ISI_OMADAC_ID
OMADA_CLIENT_ID=ISI_CLIENT_ID
OMADA_CLIENT_SECRET=ISI_CLIENT_SECRET
# Kosongkan untuk mengambil semua site. Isi comma-separated untuk filter.
OMADA_SITE_IDS=
# false hanya untuk controller self-hosted dengan sertifikat self-signed di LAN terpercaya.
OMADA_VERIFY_SSL=false

# --- Ruijie ---
# app_id/app_secret minta ke distributor/partner portal Ruijie.
RUIJIE_ENABLED=false
RUIJIE_LABEL=ruijie-cloud
RUIJIE_BASE_URL=https://cloud-as.ruijienetworks.com
RUIJIE_APP_ID=ISI_APP_ID
RUIJIE_APP_SECRET=ISI_APP_SECRET
# Kosongkan untuk semua project/group. Isi comma-separated untuk filter.
RUIJIE_GROUP_IDS=
RUIJIE_VERIFY_SSL=true

# --- UniFi Network Application (controller self-hosted: UDM/UDM-Pro/UCG,
# CloudKey, atau software controller) — BUKAN UniFi Site Manager cloud. ---
# Buat local admin/user khusus poller di controller (Settings > Admins),
# beri role "Viewer"/"Read Only" kalau tersedia. Non-aktifkan 2FA untuk
# akun ini — poller tidak mendukung 2FA.
UNIFI_ENABLED=false
UNIFI_LABEL=unifi-kantor-pusat
# UDM/UDM-Pro/UCG: https://<ip-console>  (mis. https://192.168.1.1)
# Software controller/CloudKey Gen1: https://<host>:8443
UNIFI_BASE_URL=https://192.168.1.1
UNIFI_USERNAME=ISI_USERNAME
UNIFI_PASSWORD=ISI_PASSWORD
# Site short-name, BUKAN nama tampilan. Lihat di URL controller saat buka
# site: .../manage/site/<INI>/dashboard. Kosongkan untuk site "default".
# Comma-separated untuk multi-site.
UNIFI_SITE_IDS=
# false hanya untuk controller self-hosted dengan sertifikat self-signed di LAN terpercaya.
UNIFI_VERIFY_SSL=false
